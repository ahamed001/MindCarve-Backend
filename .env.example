# --- Server ---
NODE_ENV=development
PORT=4500
CLIENT_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# --- Database ---
MONGO_URI=
DATABASE_NAME=mindcarve
USE_IN_MEMORY_DB=false
# Local dev DB folder (persists across restarts). Use DEV_DB_PATH=memory for a throwaway DB.
DEV_DB_PATH=.dev-db

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
INVITATION_TTL_HOURS=72
RESET_TTL_MINUTES=30

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Athma Mind Care Hospital <no-reply@athma.example>"

# --- Seed (development admin) ---
SEED_ADMIN_NAME=Athma Admin
SEED_ADMIN_EMAIL=admin@athma.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- Seed (development patient login; never created when NODE_ENV=production) ---
SEED_PATIENT_NAME=Test Patient
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=
